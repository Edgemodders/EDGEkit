{
  "//": "Extensions built into EDGEkit. On the dev PC, tools/bundle.mjs builds each sibling one with its own script and unpacks the newest VSIX. For a release (K4), \"version\" pins the one shipped, downloaded from the repo's GitHub release.",
  "extensions": [
    {
      "id": "edgemodders.redcode",
      "from": "sibling",
      "repo": "../REDcode",
      "build": "npm run redcode:package",
      "vsix": "dist/redcode-*.vsix",
      "status": "exists",
      "version": null
    },
    {
      "id": "edgemodders.rednode-hud-theme",
      "from": "sibling",
      "repo": "../REDcode",
      "build": "npm run theme:package",
      "vsix": "dist/rednode-hud-theme-*.vsix",
      "status": "exists",
      "defaultTheme": true,
      "version": null
    },
    {
      "id": "edgemodders.reddeck",
      "from": "sibling",
      "repo": "../REDdeck",
      "build": "npm run package",
      "vsix": "dist/reddeck-win32-x64-*.vsix",
      "status": "exists",
      "version": null
    },
    {
      "id": "edgemodders.redagent",
      "from": "sibling",
      "repo": "../REDagent",
      "build": null,
      "vsix": null,
      "status": "Placeholder. REDagent is a REDnode package (in game, C5 passed); its editor view is REDagent's phase C6, not started. Whether the view is its own extension or part of REDcode is REDagent's decision, so this id may change",
      "version": null
    },
    {
      "id": "edgemodders.edgemat",
      "from": "sibling",
      "repo": "../EDGEmat",
      "build": null,
      "vsix": null,
      "status": "EDGEmat phase M0, not built yet",
      "version": null
    },
    {
      "id": "edgemodders.edgewave",
      "from": "sibling",
      "repo": "../EDGEwave",
      "build": null,
      "vsix": null,
      "status": "EDGEwave in development (0.0.1), no package script yet",
      "version": null
    },
    {
      "id": "jac3km4.redscript-ide-vscode",
      "from": "source",
      "repo": "https://github.com/jac3km4/redscript-ide-vscode",
      "license": "MIT",
      "server": {
        "repo": "https://github.com/jac3km4/redscript-ide",
        "license": "MIT",
        "asset": "redscript-ide.exe",
        "setting": "redscript.idePath"
      },
      "status": "K3: build from source and bundle with its notice; the author is being told and asked about Open VSX",
      "version": null
    }
  ]
}
